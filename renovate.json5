{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":semanticCommitsDisabled",
  ],
  labels: ["dependencies"],
  // One line, no body: same rule as hand-written commits.
  commitMessageTopic: "{{depName}}",
  // Base images are pinned by digest and Renovate keeps those fresh, which is the
  // guarantee the mergerfs tarball cannot have.
  pinDigests: true,
  packageRules: [
    {
      // The go directive and the golang image must move together: a toolchain
      // older than the directive does not build.
      matchDatasources: ["golang-version", "docker"],
      matchPackageNames: ["go", "golang"],
      groupName: "go toolchain",
    },
    {
      matchManagers: ["gomod"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "go dependencies",
    },
    {
      // The k8s libraries are released in lockstep and do not compile against
      // mismatched versions of each other.
      matchManagers: ["gomod"],
      matchPackageNames: ["k8s.io/**", "sigs.k8s.io/**"],
      groupName: "kubernetes libraries",
    },
    {
      matchManagers: ["github-actions"],
      groupName: "github actions",
    },
    {
      matchDepNames: ["trapexit/mergerfs"],
      prBodyNotes: [
        "The pinned sha256 digests in `hack/mergerfs.pin` are **not** updated automatically. Run `make update-mergerfs` on this branch, otherwise the image build fails its checksum check.",
      ],
    },
  ],
  customManagers: [
    {
      // Tool versions pinned inside workflow steps, marked with a renovate comment.
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+version: (?<currentValue>\\S+)",
      ],
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^hack/mergerfs\\.pin$/"],
      matchStrings: ["version=(?<currentValue>\\S+)"],
      datasourceTemplate: "github-releases",
      depNameTemplate: "trapexit/mergerfs",
      versioningTemplate: "loose",
    },
  ],
}
